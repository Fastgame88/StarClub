// StarClubHTTPClient.bsl
// Приклад загального модуля 1С для REST-інтеграції зі Star Club.
// Це шаблон. Його треба адаптувати під вашу конфігурацію 1С / РРО / касову обробку.
// Потрібні константи або налаштування:
// - StarClubApiUrl: https://your-domain.up.railway.app
// - StarClubApiToken: ONE_C_API_TOKEN

Функция StarClubApiUrl() Экспорт
    // Замінити на отримання з константи/регістру налаштувань.
    Возврат "http://localhost:3000";
КонецФункции

Функция StarClubApiToken() Экспорт
    // Замінити на отримання з константи/регістру налаштувань.
    Возврат "change-this-1c-token";
КонецФункции

Функция StarClubJsonToString(Данные) Экспорт
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция StarClubStringToJson(СтрокаJSON) Экспорт
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Данные = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();
    Возврат Данные;
КонецФункции

Функция StarClubRequest(Метод, Путь, Тело = Неопределено) Экспорт
    Адрес = StarClubApiUrl();
    // Для production краще розібрати URL на сервер/порт/SSL штатними засобами вашої конфігурації.
    // Нижче базовий приклад для простого HTTP. Для HTTPS потрібен ЗащищенноеСоединениеOpenSSL.

    Если СтрНачинаетсяС(Адрес, "https://") Тогда
        ПротоколHTTPS = Истина;
        АдресБезПротокола = СтрЗаменить(Адрес, "https://", "");
        Порт = 443;
    Иначе
        ПротоколHTTPS = Ложь;
        АдресБезПротокола = СтрЗаменить(Адрес, "http://", "");
        Порт = 80;
    КонецЕсли;

    Части = СтрРазделить(АдресБезПротокола, ":");
    Сервер = Части[0];
    Если Части.Количество() > 1 Тогда
        Порт = Число(Части[1]);
    КонецЕсли;

    Если ПротоколHTTPS Тогда
        Соединение = Новый HTTPСоединение(Сервер, Порт,,,,, Новый ЗащищенноеСоединениеOpenSSL());
    Иначе
        Соединение = Новый HTTPСоединение(Сервер, Порт);
    КонецЕсли;

    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Content-Type", "application/json");
    Запрос.Заголовки.Вставить("X-Starclub-Token", StarClubApiToken());

    Если Тело <> Неопределено Тогда
        Запрос.УстановитьТелоИзСтроки(StarClubJsonToString(Тело), КодировкаТекста.UTF8);
    КонецЕсли;

    Если Метод = "GET" Тогда
        Ответ = Соединение.Получить(Запрос);
    ИначеЕсли Метод = "POST" Тогда
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Иначе
        ВызватьИсключение "Непідтримуваний метод Star Club API: " + Метод;
    КонецЕсли;

    Код = Ответ.КодСостояния;
    Текст = Ответ.ПолучитьТелоКакСтроку();
    Если Код < 200 Или Код >= 300 Тогда
        ВызватьИсключение "Star Club API error " + Строка(Код) + ": " + Текст;
    КонецЕсли;

    Возврат StarClubStringToJson(Текст);
КонецФункции

Функция StarClubFindClientByPhone(Телефон) Экспорт
    Путь = "/api/1c/client/search?phone=" + КодироватьСтроку(Телефон, СпособКодированияСтроки.КодировкаURL);
    Возврат StarClubRequest("GET", Путь);
КонецФункции

Функция StarClubFindClientByCard(НомерКарты) Экспорт
    Путь = "/api/1c/client/search?card_number=" + КодироватьСтроку(НомерКарты, СпособКодированияСтроки.КодировкаURL);
    Возврат StarClubRequest("GET", Путь);
КонецФункции

Функция StarClubValidateRewardQr(QrToken) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("token", QrToken);
    Возврат StarClubRequest("POST", "/api/1c/reward-qr/validate", Тело);
КонецФункции

Функция StarClubFinalizeRewardQr(QrToken, ReceiptId, StoreId) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("token", QrToken);
    Тело.Вставить("receipt_id", ReceiptId);
    Тело.Вставить("store_id", StoreId);
    Возврат StarClubRequest("POST", "/api/1c/reward-qr/finalize", Тело);
КонецФункции

Функция StarClubCancelRewardQr(QrToken, StoreId, Reason) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("token", QrToken);
    Тело.Вставить("store_id", StoreId);
    Тело.Вставить("reason", Reason);
    Возврат StarClubRequest("POST", "/api/1c/reward-qr/cancel", Тело);
КонецФункции

Функция StarClubSendReceipt(Чек) Экспорт
    // Чек — структура в форматі docs/api-contract.md.
    Возврат StarClubRequest("POST", "/api/1c/receipts", Чек);
КонецФункции

Функция StarClubSendReturn(ВозвратЧека) Экспорт
    // ВозвратЧека — структура в форматі docs/api-contract.md.
    Возврат StarClubRequest("POST", "/api/1c/returns", ВозвратЧека);
КонецФункции

Функция StarClubBuildReceiptExample() Экспорт
    Чек = Новый Структура;
    Чек.Вставить("id", "CHK-TEST-001");
    Чек.Вставить("fiscal_number", "FN-123456");
    Чек.Вставить("purchased_at", "2026-05-17T12:30:00+03:00");
    Чек.Вставить("store_id", "star-center");
    Чек.Вставить("cash_register", "KASA-1");
    Чек.Вставить("cashier", "Іван");
    Чек.Вставить("phone", "+380501112233");
    Чек.Вставить("total_cents", 6000);

    Позиции = Новый Массив;

    Флаги = Новый Структура;
    Флаги.Вставить("is_alcohol", Ложь);
    Флаги.Вставить("is_tobacco", Ложь);
    Флаги.Вставить("is_min_margin", Ложь);
    Флаги.Вставить("no_star_accrual", Ложь);
    Флаги.Вставить("no_redeem", Ложь);

    Позиция = Новый Структура;
    Позиция.Вставить("external_product_id", "1C-COFFEE-001");
    Позиция.Вставить("name", "Кава");
    Позиция.Вставить("category", "coffee");
    Позиция.Вставить("qty", 1);
    Позиция.Вставить("price_cents", 3500);
    Позиция.Вставить("line_total_cents", 3500);
    Позиция.Вставить("flags", Флаги);
    Позиции.Добавить(Позиция);

    Позиция2 = Новый Структура;
    Позиция2.Вставить("external_product_id", "1C-BAGUETTE-001");
    Позиция2.Вставить("name", "Багет");
    Позиция2.Вставить("category", "bakery");
    Позиция2.Вставить("qty", 1);
    Позиция2.Вставить("price_cents", 2500);
    Позиция2.Вставить("line_total_cents", 2500);
    Позиция2.Вставить("flags", Флаги);
    Позиции.Добавить(Позиция2);

    Чек.Вставить("items", Позиции);
    Возврат Чек;
КонецФункции
