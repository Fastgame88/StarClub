# Server
PORT=3000
APP_URL=https://your-domain.up.railway.app
NODE_ENV=development

# SQLite path. On Railway set this to a mounted volume, for example /data/star-club.sqlite
DATABASE_FILE=./data/star-club.sqlite

# Telegram
BOT_TOKEN=123456:telegram_bot_token_from_botfather
WEBAPP_URL=https://your-domain.up.railway.app
RUN_BOT=false

# API tokens
ADMIN_API_KEY=change-this-admin-key
ONE_C_API_TOKEN=change-this-1c-token

# Demo mode: true allows login without real Telegram initData for browser preview
ALLOW_DEV_LOGIN=true

# Do not create fake customers/progress by default
ENABLE_DEMO_ACCOUNT=false
