// StarClubИнтеграция — загальний модуль 1С
// Властивості модуля: Сервер = Так, Клієнт = Так, Зовнішнє з'єднання = Так, Виклик сервера = Так.
// Для Railway в АдресСервера вписувати домен без https://

Функция StarClubАдресСервера() Экспорт
	Возврат "web-production-967ed.up.railway.app";
КонецФункции

Функция StarClubПортСервера() Экспорт
	Возврат 443;
КонецФункции

Функция StarClubКлючAPI() Экспорт
	// Має співпадати з Railway Variables: ONE_C_API_TOKEN
	Возврат "change-this-1c-token";
КонецФункции

Функция StarClubHTTPСоединение() Экспорт
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Возврат Новый HTTPСоединение(
		StarClubАдресСервера(),
		StarClubПортСервера(),
		,
		,
		,
		30,
		ЗащищенноеСоединение
	);
КонецФункции

Функция StarClubPOST(ПутьAPI, Данные) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	HTTPЗапрос = Новый HTTPЗапрос(ПутьAPI);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("x-starclub-token", StarClubКлючAPI());
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

	HTTPОтвет = StarClubHTTPСоединение().ОтправитьДляОбработки(HTTPЗапрос);
	Возврат HTTPОтвет;
КонецФункции

Функция StarClubGET(ПутьAPI) Экспорт
	HTTPЗапрос = Новый HTTPЗапрос(ПутьAPI);
	HTTPЗапрос.Заголовки.Вставить("x-starclub-token", StarClubКлючAPI());
	HTTPОтвет = StarClubHTTPСоединение().Получить(HTTPЗапрос);
	Возврат HTTPОтвет;
КонецФункции

Функция StarClubПрочитатьJSON(СтрокаJSON) Экспорт
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON);
	Возврат Данные;
КонецФункции

Функция ОчиститиКодКартиStarClub(КодКарты) Экспорт
	Код = Строка(КодКарты);
	Код = СтрЗаменить(Код, " ", "");
	Код = СтрЗаменить(Код, "-", "");
	Код = СтрЗаменить(Код, Символ(160), "");
	Возврат Код;
КонецФункции

Функция StarClubОтриматиПоле(СтруктураДанных, ИмяПоля, ЗначениеПоУмолчанию = "") Экспорт
	Если ТипЗнч(СтруктураДанных) = Тип("Структура") Тогда
		Если СтруктураДанных.Свойство(ИмяПоля) Тогда
			Возврат СтруктураДанных[ИмяПоля];
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Процедура StarClubБезопасноУстановить(Объект, ИмяРеквизита, Значение) Экспорт
	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
		// Якщо в конкретній конфігурації такого реквізиту немає — просто пропускаємо.
	КонецПопытки;
КонецПроцедуры

Функция StarClubЗнайтиТипКартиДляКлієнтів() Экспорт
	// Беремо тип картки з уже існуючих клієнтських карток 1С.
	// У різних конфігураціях реквізит може називатися ТипКарты/ТипКартки.
	Попытка
		Выборка = Справочники.ИнформационныеКарты.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ Выборка.ЭтоГруппа Тогда
				Попытка
					Если ЗначениеЗаполнено(Выборка.ТипКарты) Тогда
						Возврат Выборка.ТипКарты;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Функция StarClubЗнайтиГрупуПокупців() Экспорт
	// У типовій роздрібній конфігурації вже є папка "Картки покупців".
	// Карти Star Club краще створювати всередині неї або всередині нашої підпапки,
	// інакше форма вибору дисконтної карти може їх не показувати через відбір.
	ИменаГрупп = Новый Массив;
	ИменаГрупп.Добавить("Картки покупців");
	ИменаГрупп.Добавить("Карты покупателей");
	ИменаГрупп.Добавить("Карти покупців");

	Для Каждого ИмяГруппы Из ИменаГрупп Цикл
		Попытка
			Группа = Справочники.ИнформационныеКарты.НайтиПоНаименованию(ИмяГруппы, Истина);
			Если ЗначениеЗаполнено(Группа) И НЕ Группа.Пустая() Тогда
				Возврат Группа;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Функция StarClubЗнайтиГрупуБонуснихКарток(Создавать = Истина) Экспорт
	ИмяГруппы = "Бонусні картки Star Club";

	Попытка
		Группа = Справочники.ИнформационныеКарты.НайтиПоНаименованию(ИмяГруппы, Истина);
		Если ЗначениеЗаполнено(Группа) И НЕ Группа.Пустая() Тогда
			Возврат Группа;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если НЕ Создавать Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		НоваяГруппа = Справочники.ИнформационныеКарты.СоздатьГруппу();
		НоваяГруппа.Наименование = ИмяГруппы;

		// Робимо Star Club підпапкою папки покупців, якщо така існує.
		ГруппаПокупцев = StarClubЗнайтиГрупуПокупців();
		Если ГруппаПокупцев <> Неопределено Тогда
			Попытка
				НоваяГруппа.Родитель = ГруппаПокупцев;
			Исключение
			КонецПопытки;
		КонецЕсли;

		// Якщо в конфігурації є реквізит ТипКарты — проставляємо його.
		ТипКарты = StarClubЗнайтиТипКартиДляКлієнтів();
		Если ТипКарты <> Неопределено Тогда
			StarClubБезопасноУстановить(НоваяГруппа, "ТипКарты", ТипКарты);
			StarClubБезопасноУстановить(НоваяГруппа, "ТипКартки", ТипКарты);
		КонецЕсли;

		НоваяГруппа.Записать();
		Возврат НоваяГруппа.Ссылка;
	Исключение
		Сообщить("Star Club: не вдалося створити папку бонусних карток: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция StarClubЗнайтиКарткуВ1С(КодКарты) Экспорт
	Код = СокрЛП(Строка(КодКарты));
	Если Код = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодЧистый = ОчиститиКодКартиStarClub(Код);

	Попытка
		Выборка = Справочники.ИнформационныеКарты.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;

			ТекКод = "";
			Попытка
				ТекКод = Строка(Выборка.КодКарты);
			Исключение
				ТекКод = Строка(Выборка.Наименование);
			КонецПопытки;

			Если СокрЛП(ТекКод) = Код Или ОчиститиКодКартиStarClub(ТекКод) = КодЧистый Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Функция StarClubСтворитиАбоОновитиКарткуВ1С(ДанныеКлиента, ПоказуватиПодробиці = Ложь) Экспорт
	КодКарты = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "card_number", "")));
	Если КодКарты = "" Тогда
		Если ПоказуватиПодробиці Тогда
			Сообщить("Star Club: клієнт без номера картки пропущений.");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Имя = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "name", "")));
	Телефон = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "phone", "")));
	Баланс = Строка(StarClubОтриматиПоле(ДанныеКлиента, "stars_balance", 0));
	Доступно = Строка(StarClubОтриматиПоле(ДанныеКлиента, "available_stars", Баланс));
	Штрихкод = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "barcode", ОчиститиКодКартиStarClub(КодКарты))));

	СсылкаКарты = StarClubЗнайтиКарткуВ1С(КодКарты);
	Если ЗначениеЗаполнено(СсылкаКарты) И СсылкаКарты <> Неопределено Тогда
		ОбъектКарты = СсылкаКарты.ПолучитьОбъект();
		Режим = "оновлено";
	Иначе
		ОбъектКарты = Справочники.ИнформационныеКарты.СоздатьЭлемент();
		Режим = "створено";
	КонецЕсли;

	Группа = StarClubЗнайтиГрупуБонуснихКарток(Истина);
	Если Группа <> Неопределено Тогда
		Попытка
			ОбъектКарты.Родитель = Группа;
		Исключение
			Сообщить("Star Club: не вдалося встановити папку для картки " + КодКарты + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ТипКарты = StarClubЗнайтиТипКартиДляКлієнтів();
	Если ТипКарты <> Неопределено Тогда
		StarClubБезопасноУстановить(ОбъектКарты, "ТипКарты", ТипКарты);
		StarClubБезопасноУстановить(ОбъектКарты, "ТипКартки", ТипКарты);
	КонецЕсли;

	Если Имя = "" Тогда
		Имя = КодКарты;
	КонецЕсли;

	// Важливо: Наименование обов'язково, інакше картка може записатись некоректно.
	ОбъектКарты.Наименование = Имя + " — " + КодКарты;

	StarClubБезопасноУстановить(ОбъектКарты, "КодКарты", КодКарты);
	StarClubБезопасноУстановить(ОбъектКарты, "КодКарти", КодКарты);
	StarClubБезопасноУстановить(ОбъектКарты, "Штрихкод", Штрихкод);
	StarClubБезопасноУстановить(ОбъектКарты, "ШтрихКод", Штрихкод);
	StarClubБезопасноУстановить(ОбъектКарты, "Комментарий", "Star Club; Телефон: " + Телефон + "; Баланс: " + Баланс + " ⭐; Доступно: " + Доступно + " ⭐");
	StarClubБезопасноУстановить(ОбъектКарты, "Телефон", Телефон);
	StarClubБезопасноУстановить(ОбъектКарты, "БалансЗірок", Баланс);
	StarClubБезопасноУстановить(ОбъектКарты, "БалансЗвезд", Баланс);
	StarClubБезопасноУстановить(ОбъектКарты, "ДоступноЗірок", Доступно);
	StarClubБезопасноУстановить(ОбъектКарты, "ДоступноЗвезд", Доступно);

	Попытка
		ОбъектКарты.Записать();
		Если ПоказуватиПодробиці Тогда
			Сообщить("Star Club: картку " + Режим + ": " + Имя + " / " + КодКарты + " / баланс " + Баланс + " ⭐");
		КонецЕсли;
		Возврат ОбъектКарты.Ссылка;
	Исключение
		Сообщить("Star Club: НЕ вдалося записати картку " + КодКарты + ": " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция StarClubМассивМіститьКод(МассивКодов, КодКарты) Экспорт
	КодЧистый = ОчиститиКодКартиStarClub(КодКарты);
	Для Каждого Код Из МассивКодов Цикл
		Если Код = КодЧистый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция StarClubОчиститиНеактуальніКарткиВ1С(АктуальніКоди) Экспорт
	Удалено = 0;
	Ошибки = 0;

	Группа = StarClubЗнайтиГрупуБонуснихКарток(Ложь);
	Если Группа = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Выборка = Справочники.ИнформационныеКарты.Выбрать(Группа);
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;

			КодКарты = "";
			Попытка
				КодКарты = Строка(Выборка.КодКарты);
			Исключение
				КодКарты = Строка(Выборка.Наименование);
			КонецПопытки;

			Если КодКарты = "" Тогда
				Продолжить;
			КонецЕсли;

			Если НЕ StarClubМассивМіститьКод(АктуальніКоди, КодКарты) Тогда
				Попытка
					ОбъектКарты = Выборка.Ссылка.ПолучитьОбъект();
					Попытка
						ОбъектКарты.Удалить();
					Исключение
						ОбъектКарты.УстановитьПометкуУдаления(Истина);
					КонецПопытки;
					Удалено = Удалено + 1;
				Исключение
					Ошибки = Ошибки + 1;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Star Club: помилка очищення старих карток: " + ОписаниеОшибки());
	КонецПопытки;

	Если Удалено > 0 Или Ошибки > 0 Тогда
		Сообщить("Star Club: очищення папки завершено. Старих карток видалено: " + Строка(Удалено) + ", помилок: " + Строка(Ошибки));
	КонецЕсли;

	Возврат Удалено;
КонецФункции


Функция СинхронізуватиКлієнтівStarClub(Пошук = "", ПоказуватиПодробиці = Ложь) Экспорт
	Попытка
		ПутьAPI = "/api/1c/clients?limit=500";
		Если СокрЛП(Строка(Пошук)) <> "" Тогда
			ПутьAPI = ПутьAPI + "&q=" + КодироватьСтроку(СокрЛП(Строка(Пошук)), СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		HTTPОтвет = StarClubGET(ПутьAPI);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
			Сообщить("Star Club: помилка синхронізації клієнтів. Код: " + Строка(HTTPОтвет.КодСостояния));
			Возврат 0;
		КонецЕсли;

		Данные = StarClubПрочитатьJSON(ОтветСтрока);
		Клиенты = StarClubОтриматиПоле(Данные, "clients", Новый Массив);
		Количество = 0;
		Ошибки = 0;
		АктуальніКоди = Новый Массив;

		Для Каждого Клиент Из Клиенты Цикл
			КодКлиента = СокрЛП(Строка(StarClubОтриматиПоле(Клиент, "card_number", "")));
			Если КодКлиента <> "" Тогда
				АктуальніКоди.Добавить(ОчиститиКодКартиStarClub(КодКлиента));
			КонецЕсли;

			СсылкаКарты = StarClubСтворитиАбоОновитиКарткуВ1С(Клиент, ПоказуватиПодробиці);
			Если СсылкаКарты <> Неопределено Тогда
				Количество = Количество + 1;
			Иначе
				Ошибки = Ошибки + 1;
			КонецЕсли;
		КонецЦикла;

		Если СокрЛП(Строка(Пошук)) <> "" Тогда
			Сообщить("Star Club: знайдено/оновлено карток за пошуком [" + Строка(Пошук) + "]: " + Строка(Количество));
		Иначе
			УдаленоСтарих = StarClubОчиститиНеактуальніКарткиВ1С(АктуальніКоди);
			Сообщить("Star Club: синхронізація завершена. Актуальних карток записано: " + Строка(Количество) + ", старих прибрано: " + Строка(УдаленоСтарих) + ", помилок: " + Строка(Ошибки));
		КонецЕсли;

		Возврат Количество;
	Исключение
		Сообщить("Star Club: помилка синхронізації клієнтів: " + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ШвидкийПошукКлієнтаStarClub(Пошук) Экспорт
	Пошук = СокрЛП(Строка(Пошук));
	Если Пошук = "" Тогда
		Сообщить("Star Club: введіть телефон або номер картки.");
		Возврат Неопределено;
	КонецЕсли;

	// Спочатку забираємо з сервера тільки клієнтів, які підходять під телефон/картку/ім'я.
	СинхронізуватиКлієнтівStarClub(Пошук, Ложь);

	Карта = StarClubЗнайтиКарткуВ1С(Пошук);
	Если Карта = Неопределено Тогда
		// Якщо ввели телефон, карта могла не знайтися локально за кодом карти, тому робимо прямий запит балансу.
		ЗнайтиКлієнтаStarClub(Пошук);
		Возврат Неопределено;
	КонецЕсли;

	ПоказатиБалансКарткиStarClub(Карта);
	Возврат Карта;
КонецФункции

Функция ЗнайтиКлієнтаStarClub(КодКартыИлиТелефон) Экспорт
	Попытка
		Код = СокрЛП(Строка(КодКартыИлиТелефон));
		КодБезПробелов = ОчиститиКодКартиStarClub(Код);
		ПутьAPI = "/api/1c/client/search?card_number=" + КодироватьСтроку(Код, СпособКодированияСтроки.КодировкаURL)
			+ "&card_token=" + КодироватьСтроку(КодБезПробелов, СпособКодированияСтроки.КодировкаURL)
			+ "&phone=" + КодироватьСтроку(Код, СпособКодированияСтроки.КодировкаURL);

		HTTPОтвет = StarClubGET(ПутьAPI);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Данные = StarClubПрочитатьJSON(ОтветСтрока);
			Если StarClubОтриматиПоле(Данные, "found", Ложь) Тогда
				Клиент = StarClubОтриматиПоле(Данные, "client", Новый Структура);
				Имя = Строка(StarClubОтриматиПоле(Клиент, "name", ""));
				Телефон = Строка(StarClubОтриматиПоле(Клиент, "phone", ""));
				Карта = Строка(StarClubОтриматиПоле(Клиент, "card_number", Код));
				Баланс = Строка(StarClubОтриматиПоле(Клиент, "stars_balance", 0));
				Доступно = Строка(StarClubОтриматиПоле(Клиент, "available_stars", Баланс));
				Предупреждение("Star Club" + Символы.ПС + "Клієнт: " + Имя + Символы.ПС + "Телефон: " + Телефон + Символы.ПС + "Карта: " + Карта + Символы.ПС + "Баланс: " + Баланс + " ⭐" + Символы.ПС + "Доступно: " + Доступно + " ⭐");
				Возврат ОтветСтрока;
			Иначе
				Сообщить("Star Club: клієнта не знайдено за кодом: " + Код);
				Возврат ОтветСтрока;
			КонецЕсли;
		Иначе
			Сообщить("Star Club: помилка пошуку клієнта. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка пошуку клієнта: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ПоказатиБалансКарткиStarClub(КартаСсылка) Экспорт
	Если НЕ ЗначениеЗаполнено(КартаСсылка) Тогда
		Сообщить("Star Club: спочатку виберіть дисконтну картку.");
		Возврат "";
	КонецЕсли;
	Попытка
		КодКарты = Строка(КартаСсылка.КодКарты);
	Исключение
		КодКарты = Строка(КартаСсылка);
	КонецПопытки;
	Возврат ЗнайтиКлієнтаStarClub(КодКарты);
КонецФункции

Функция ПеревіритиКодТовараЗаЗірки(КодQR) Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/validate", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			ДанныеОтвета = StarClubПрочитатьJSON(ОтветСтрока);
			QR = StarClubОтриматиПоле(ДанныеОтвета, "qr", Новый Структура);
			Клиент = StarClubОтриматиПоле(QR, "client", Новый Структура);
			Товар = Строка(StarClubОтриматиПоле(QR, "product_name", ""));
			КодТовара1С = Строка(StarClubОтриматиПоле(QR, "product_external_id", ""));
			Кількість = Строка(StarClubОтриматиПоле(QR, "qty", 1));
			ЦінаГрн = Строка(StarClubОтриматиПоле(QR, "price_uah", 0));
			Зірки = Строка(StarClubОтриматиПоле(QR, "stars_to_spend", 0));
			Статус = Строка(StarClubОтриматиПоле(ДанныеОтвета, "status", "reserved"));
			Карта = Строка(StarClubОтриматиПоле(Клиент, "card_number", ""));
			Телефон = Строка(StarClubОтриматиПоле(Клиент, "phone", ""));
			Баланс = Строка(StarClubОтриматиПоле(Клиент, "balance", ""));
			Текст = "Star Club: код товару дійсний" + Символы.ПС
				+ "Статус: " + Статус + Символы.ПС
				+ "Товар: " + Товар + Символы.ПС
				+ "Код товару 1С: " + КодТовара1С + Символы.ПС
				+ "Кількість: " + Кількість + Символы.ПС
				+ "Ціна в грн: " + ЦінаГрн + Символы.ПС
				+ "Ціна в зірках: " + Зірки + " ⭐" + Символы.ПС
				+ "Карта: " + Карта + Символы.ПС
				+ "Телефон: " + Телефон + Символы.ПС
				+ "Баланс до списання: " + Баланс + " ⭐";
			Предупреждение(Текст);
			Возврат ОтветСтрока;
		Иначе
			Сообщить("Star Club: код недійсний. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка перевірки коду: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ПідтвердитиКодТовараЗаЗірки(КодQR, НомерЧека, Магазин = "1c") Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));
		Данные.Вставить("receipt_id", Строка(НомерЧека));
		Данные.Вставить("store_id", Строка(Магазин));

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/finalize", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Сообщить("Star Club: код використано, зірки списано.");
			Возврат ОтветСтрока;
		Иначе
			Сообщить("Star Club: код НЕ використано. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка підтвердження коду: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция СкасуватиКодТовараЗаЗірки(КодQR, Магазин = "1c") Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));
		Данные.Вставить("store_id", Строка(Магазин));

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/cancel", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Предупреждение("Star Club" + Символы.ПС + "Код скасовано. Зірки знову доступні клієнту." + Символы.ПС + "Код: " + Строка(КодQR));
			Возврат ОтветСтрока;
		Иначе
			Сообщить("Star Club: код не скасовано. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка скасування коду: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ЗапитатиТаПеревіритиКодТовараЗаЗірки() Экспорт
	КодQR = "";
	Если ВвестиСтроку(КодQR, "Введіть або відскануйте код товару Star Club", 100) Тогда
		Возврат ПеревіритиКодТовараЗаЗірки(КодQR);
	КонецЕсли;
