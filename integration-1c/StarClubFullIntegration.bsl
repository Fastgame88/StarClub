Функция ЗапитатиТаСкасуватиКодТовараЗаЗірки() Экспорт
	КодQR = "";
	Если ВвестиСтроку(КодQR, "Введіть код товару Star Club для скасування", 100) Тогда
		Возврат СкасуватиКодТовараЗаЗірки(КодQR);
	КонецЕсли;
	Возврат "";
КонецФункции



// ===== КОДИ ТОВАРІВ І ГРУП 1С =====
// У цій базі і товар, і група мають коди одного формату, наприклад ЦБ000004323.
// Тому код не визначає тип об'єкта: type=product/group передається окремо.

Функция StarClubНормалізуватиКод1С(Код1С) Экспорт
	Результат = ВРег(СокрЛП(Строка(Код1С)));
	Результат = СтрЗаменить(Результат, " ", "");
	Возврат Результат;
КонецФункции

Функция StarClubКодГрупиНоменклатури(Номенклатура) Экспорт
	Попытка
		Группа = Номенклатура.НоменклатурнаяГруппа;
		Если ЗначениеЗаполнено(Группа) Тогда
			Возврат StarClubНормалізуватиКод1С(Группа.Код);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

Функция StarClubШляхКодівГруп(Номенклатура) Экспорт
	Результат = Новый Массив;
	Попытка
		Группа = Номенклатура.НоменклатурнаяГруппа;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Пока ЗначениеЗаполнено(Группа) Цикл
		Попытка
			КодГруппы = StarClubНормалізуватиКод1С(Группа.Код);
			Если КодГруппы <> "" Тогда
				Результат.Добавить(КодГруппы);
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			Если НЕ ЗначениеЗаполнено(Группа.Родитель) Тогда
				Прервать;
			КонецЕсли;
			Группа = Группа.Родитель;
		Исключение
			Прервать;
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Процедура StarClubДодатиКодиТоваруІГрупи(ТоварJSON, Номенклатура) Экспорт
	КодТовара = StarClubНормалізуватиКод1С(Номенклатура.Код);
	ТоварJSON.Вставить("product_id", КодТовара);
	ТоварJSON.Вставить("external_product_id", КодТовара);

	КодГруппы = StarClubКодГрупиНоменклатури(Номенклатура);
	Если КодГруппы <> "" Тогда
		ТоварJSON.Вставить("group_external_id", КодГруппы);
	КонецЕсли;

	Попытка
		Группа = Номенклатура.НоменклатурнаяГруппа;
		Если ЗначениеЗаполнено(Группа) Тогда
			ТоварJSON.Вставить("group_name", Строка(Группа.Наименование));
			ТоварJSON.Вставить("category", Строка(Группа.Наименование));
		Иначе
			ТоварJSON.Вставить("category", "");
		КонецЕсли;
	Исключение
		ТоварJSON.Вставить("category", "");
	КонецПопытки;

	ТоварJSON.Вставить("group_path", StarClubШляхКодівГруп(Номенклатура));
КонецПроцедуры

// ===== СИНХРОНІЗАЦІЯ ТОВАРІВ І ГРУП У STAR CLUB =====
// Після запуску товари та групи з кодами виду ЦБ000004323 з'являються
// в адмінці Star Club для точного вибору product/group.

Функция StarClubВідправитиПакетНоменклатури(ПакетТоварів) Экспорт
	Если ПакетТоварів.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("products", ПакетТоварів);
	HTTPОтвет = StarClubPOST("/api/1c/products/sync", Данные);
	ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

	Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
		ВызватьИсключение "Star Club: помилка синхронізації товарів. HTTP "
			+ Строка(HTTPОтвет.КодСостояния) + ": " + ОтветСтрока;
	КонецЕсли;

	Ответ = StarClubПрочитатьJSON(ОтветСтрока);
	Возврат Число(StarClubОтриматиПоле(Ответ, "synced", 0));
КонецФункции

Процедура СинхронізуватиНоменклатуруStarClub(РазмерПакета = 200) Экспорт
	Если РазмерПакета < 1 Тогда
		РазмерПакета = 200;
	КонецЕсли;

	ВсегоОтправлено = 0;
	Пакет = Новый Массив;

	Попытка
		Выборка = Справочники.Номенклатура.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;

			Товар = Новый Структура;
			КодТовара = StarClubНормалізуватиКод1С(Выборка.Код);
			Если КодТовара = "" Тогда
				Продолжить;
			КонецЕсли;

			Товар.Вставить("external_id", КодТовара);
			Товар.Вставить("name", Строка(Выборка.Наименование));

			КодГруппы = StarClubКодГрупиНоменклатури(Выборка.Ссылка);
			Товар.Вставить("group_external_id", КодГруппы);
			Товар.Вставить("group_path", StarClubШляхКодівГруп(Выборка.Ссылка));

			Попытка
				Группа = Выборка.НоменклатурнаяГруппа;
				Если ЗначениеЗаполнено(Группа) Тогда
					Товар.Вставить("group_name", Строка(Группа.Наименование));
					Товар.Вставить("category", Строка(Группа.Наименование));
				Иначе
					Товар.Вставить("group_name", "");
					Товар.Вставить("category", "");
				КонецЕсли;
			Исключение
				Товар.Вставить("group_name", "");
				Товар.Вставить("category", "");
			КонецПопытки;

			// Для вибору в адмінці достатньо коду/назви/групи.
			// Реальна базова ціна для розрахунку приходить із поточного чека.
			Товар.Вставить("price_cents", 0);

			Пакет.Добавить(Товар);
			Если Пакет.Количество() >= РазмерПакета Тогда
				ВсегоОтправлено = ВсегоОтправлено + StarClubВідправитиПакетНоменклатури(Пакет);
				Пакет = Новый Массив;
			КонецЕсли;
		КонецЦикла;

		Если Пакет.Количество() > 0 Тогда
			ВсегоОтправлено = ВсегоОтправлено + StarClubВідправитиПакетНоменклатури(Пакет);
		КонецЕсли;

		Сообщить("Star Club: синхронізацію номенклатури завершено. Передано: " + Строка(ВсегоОтправлено));
	Исключение
		Сообщить("Star Club: помилка синхронізації номенклатури: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// ===== ПОПЕРЕДНІЙ РОЗРАХУНОК КЛУБНИХ ЦІН, ОПТОВИХ ЦІН ТА МНОЖНИКІВ =====

Функция РозрахуватиКлубніУмовиStarClub(ТоварыЧека, ДисконтнаяКарта, Магазин, ДатаЧека = Неопределено) Экспорт
	Попытка
		Если НЕ ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
			Сообщить("Star Club: спочатку виберіть бонусну картку клієнта.");
			Возврат Неопределено;
		КонецЕсли;

		Если ДатаЧека = Неопределено Тогда
			ДатаЧека = ТекущаяДата();
		КонецЕсли;

		Данные = Новый Структура;
		КодКарты = Строка(ДисконтнаяКарта.КодКарты);
		Данные.Вставить("card_number", КодКарты);
		Данные.Вставить("card_token", ОчиститиКодКартиStarClub(КодКарты));
		Данные.Вставить("store_id", Строка(Магазин));
		Данные.Вставить("purchased_at", Формат(ДатаЧека, "ДФ=yyyy-MM-ddTHH:mm:ss"));

		МассивТоваров = Новый Массив;
		НомерСтроки = 0;

		Для Каждого СтрокаТовара Из ТоварыЧека Цикл
			НомерСтроки = НомерСтроки + 1;
			ТоварJSON = Новый Структура;
			ТоварJSON.Вставить("line_no", НомерСтроки);
			StarClubДодатиКодиТоваруІГрупи(ТоварJSON, СтрокаТовара.Номенклатура);
			ТоварJSON.Вставить("name", Строка(СтрокаТовара.Номенклатура.Наименование));
			ТоварJSON.Вставить("qty", СтрокаТовара.Количество);
			ТоварJSON.Вставить("price_cents", Окр(СтрокаТовара.Цена * 100, 0));
			ТоварJSON.Вставить("line_total_cents", Окр(СтрокаТовара.Сумма * 100, 0));

			Флаги = Новый Структура;
			Флаги.Вставить("is_alcohol", Ложь);
			Флаги.Вставить("is_tobacco", Ложь);
			Флаги.Вставить("is_min_margin", Ложь);
			Флаги.Вставить("no_star_accrual", Ложь);
			Флаги.Вставить("no_redeem", Ложь);

			Попытка
				Если СтрокаТовара.Номенклатура.ПодакцизныйТовар Тогда
					Флаги.is_alcohol = Истина;
					Флаги.no_star_accrual = Истина;
					Флаги.no_redeem = Истина;
				КонецЕсли;
			Исключение
			КонецПопытки;

			ТоварJSON.Вставить("flags", Флаги);
			МассивТоваров.Добавить(ТоварJSON);
		КонецЦикла;

		Если МассивТоваров.Количество() = 0 Тогда
			Сообщить("Star Club: у чеку немає товарів для розрахунку.");
			Возврат Неопределено;
		КонецЕсли;

		Данные.Вставить("items", МассивТоваров);
		HTTPОтвет = StarClubPOST("/api/1c/calculate", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
			Сообщить("Star Club: помилка попереднього розрахунку. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат Неопределено;
		КонецЕсли;

		Возврат StarClubПрочитатьJSON(ОтветСтрока);

	Исключение
		Сообщить("Star Club: помилка розрахунку клубних умов: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ЗастосуватиКлубніУмовиStarClub(ТоварыЧека, ДисконтнаяКарта, Магазин, ДатаЧека = Неопределено) Экспорт
	Ответ = РозрахуватиКлубніУмовиStarClub(ТоварыЧека, ДисконтнаяКарта, Магазин, ДатаЧека);
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Ответ.Свойство("items") Тогда
		Сообщить("Star Club: сервер не повернув розраховані товари.");
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого РезультатТовара Из Ответ.items Цикл
		НомерСтроки = Число(РезультатТовара.line_no);
		Если НомерСтроки < 1 Или НомерСтроки > ТоварыЧека.Количество() Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТовара = ТоварыЧека.Получить(НомерСтроки - 1);
		ОбычнаяЦена = Число(РезультатТовара.regular_price_cents) / 100;
		ИтоговаяЦена = Число(РезультатТовара.final_price_cents) / 100;
		ИтоговаяСумма = Число(РезультатТовара.final_line_total_cents) / 100;
		СкидкаСумма = Число(РезультатТовара.discount_cents) / 100;

		СтрокаТовара.Цена = ИтоговаяЦена;
		СтрокаТовара.Сумма = ИтоговаяСумма;

		Попытка
			СтрокаТовара.Скидка = СкидкаСумма;
		Исключение
		КонецПопытки;

		Попытка
			Если ОбычнаяЦена > 0 Тогда
				СтрокаТовара.ПроцентСкидки = Окр((ОбычнаяЦена - ИтоговаяЦена) / ОбычнаяЦена * 100, 2);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	ОбычнаяСумма = Число(Ответ.regular_total_cents) / 100;
	ИтоговаяСуммаЧека = Число(Ответ.final_total_cents) / 100;
	СкидкаЧека = Число(Ответ.discount_total_cents) / 100;
	БудущиеЗвезды = Число(Ответ.expected_stars);

	Сообщить(
		"Star Club: клубні умови застосовано." + Символы.ПС +
		"Звичайна сума: " + Формат(ОбычнаяСумма, "ЧДЦ=2") + " грн" + Символы.ПС +
		"Сума зі знижками: " + Формат(ИтоговаяСуммаЧека, "ЧДЦ=2") + " грн" + Символы.ПС +
		"Економія: " + Формат(СкидкаЧека, "ЧДЦ=2") + " грн" + Символы.ПС +
		"Буде нараховано: " + Строка(БудущиеЗвезды) + " зірок"
	);

	Возврат Ответ;
КонецФункции

Функция StarClubКодЗаЗіркиЗКоментаря(КомментарийЧека) Экспорт
	КомментарийСтрокой = Строка(КомментарийЧека);
	Маркер = "STARCLUB_CODE=";
	Позиция = СтрНайти(КомментарийСтрокой, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Код = Сред(КомментарийСтрокой, Позиция + СтрДлина(Маркер));
	ПозицияПереноса = СтрНайти(Код, Символы.ПС);
	Если ПозицияПереноса > 0 Тогда
		Код = Лев(Код, ПозицияПереноса - 1);
	КонецЕсли;

	Возврат СокрЛП(Код);
КонецФункции

Функция ПеревіритиКодТовараЗаЗіркиСтруктура(КодQR) Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/validate", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
			Сообщить("Star Club: код недійсний. Код HTTP: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат Неопределено;
		КонецЕсли;

		Возврат StarClubПрочитатьJSON(ОтветСтрока);
	Исключение
		Сообщить("Star Club: помилка перевірки коду: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ДодатиТоварЗаЗіркиВЧекStarClub(ДокументЧек, КодQR) Экспорт
	Ответ = ПеревіритиКодТовараЗаЗіркиСтруктура(КодQR);
	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	QR = StarClubОтриматиПоле(Ответ, "qr", Неопределено);
	Если QR = Неопределено Тогда
		Сообщить("Star Club: сервер не повернув дані QR-коду.");
		Возврат Ложь;
	КонецЕсли;

	КодТовара1С = СокрЛП(Строка(StarClubОтриматиПоле(QR, "product_external_id", "")));
	НазваниеТовара = Строка(StarClubОтриматиПоле(QR, "product_name", "Товар за зірки"));
	Количество = Число(StarClubОтриматиПоле(QR, "qty", 1));
	ЦенаЗірок = Число(StarClubОтриматиПоле(QR, "stars_to_spend", 0));
	ТехнічнаЦінаКоп = Число(StarClubОтриматиПоле(QR, "technical_price_cents", 10));
	Если ТехнічнаЦінаКоп < 1 Тогда
		ТехнічнаЦінаКоп = 10;
	КонецЕсли;
	ТехнічнаЦіна = ТехнічнаЦінаКоп / 100;

	Если НЕ ЗначениеЗаполнено(КодТовара1С) Тогда
		Сообщить("Star Club: для товару за зірки не вказано код товару 1С.");
		Возврат Ложь;
	КонецЕсли;

	Номенклатура = Справочники.Номенклатура.НайтиПоКоду(КодТовара1С);
	Если НЕ ЗначениеЗаполнено(Номенклатура) Или Номенклатура.Пустая() Тогда
		Сообщить("Star Club: товар не знайдено в 1С. Код: " + КодТовара1С + ", назва: " + НазваниеТовара);
		Возврат Ложь;
	КонецЕсли;

	НоваяСтрока = ДокументЧек.Товары.Добавить();
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Цена = ТехнічнаЦіна;
	НоваяСтрока.Сумма = Окр(ТехнічнаЦіна * Количество, 2);

	Попытка
		НоваяСтрока.Коэффициент = 1;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(Номенклатура.ЕдиницаХраненияОстатков) Тогда
			НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ЕдиницаХраненияОстатков;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументЧек.КассаККМ.Склад) Тогда
			НоваяСтрока.Склад = ДокументЧек.КассаККМ.Склад;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Склад) И ЗначениеЗаполнено(ДокументЧек.Магазин.Склад) Тогда
			НоваяСтрока.Склад = ДокументЧек.Магазин.Склад;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Автоматично прив'язуємо картку клієнта з QR-коду, якщо вона є у 1С.
	Клиент = StarClubОтриматиПоле(QR, "client", Новый Структура);
	КодКарты = Строка(StarClubОтриматиПоле(Клиент, "card_number", ""));
	Если ЗначениеЗаполнено(КодКарты) Тогда
		Карта1С = StarClubЗнайтиКарткуВ1С(КодКарты);
		Если ЗначениеЗаполнено(Карта1С) Тогда
			Попытка
				ДокументЧек.ДисконтнаяКарта = Карта1С;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	СтарыйКомментарий = Строка(ДокументЧек.Комментарий);
	Если СтрНайти(СтарыйКомментарий, "STARCLUB_CODE=") = 0 Тогда
		Если ЗначениеЗаполнено(СтарыйКомментарий) Тогда
			СтарыйКомментарий = СтарыйКомментарий + Символы.ПС;
		КонецЕсли;
		ДокументЧек.Комментарий = СтарыйКомментарий + "STARCLUB_CODE=" + СокрЛП(Строка(КодQR));
	КонецЕсли;

	Сообщить(
		"Star Club: товар за зірки додано в чек." + Символы.ПС +
		"Товар: " + НазваниеТовара + Символы.ПС +
		"Технічна ціна: " + Формат(ТехнічнаЦіна, "ЧДЦ=2") + " грн" + Символы.ПС +
		"До списання: " + Строка(ЦенаЗірок) + " зірок"
	);

	Возврат Истина;
КонецФункции

Процедура ОтправитьЧекВStarClub(ДокументЧек, КодQRЗаЗірки = "") Экспорт
	Попытка
		Если НЕ ЗначениеЗаполнено(КодQRЗаЗірки) Тогда
			Попытка
				КодQRЗаЗірки = StarClubКодЗаЗіркиЗКоментаря(ДокументЧек.Комментарий);
			Исключение
				КодQRЗаЗірки = "";
			КонецПопытки;
		КонецЕсли;

		ЕстьКарта = Ложь;
		Попытка
			ЕстьКарта = ЗначениеЗаполнено(ДокументЧек.ДисконтнаяКарта);
		Исключение
		КонецПопытки;

		// Звичайний чек без бонусної картки не блокуємо та не відправляємо в програму лояльності.
		Если НЕ ЕстьКарта И НЕ ЗначениеЗаполнено(КодQRЗаЗірки) Тогда
			Возврат;
		КонецЕсли;

		ДанныеЧека = Новый Структура;
		ДанныеЧека.Вставить("id", Строка(ДокументЧек.Ссылка));
		ДанныеЧека.Вставить("fiscal_number", Строка(ДокументЧек.Номер));
		ДанныеЧека.Вставить("purchased_at", Формат(ДокументЧек.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		ДанныеЧека.Вставить("store_id", Строка(ДокументЧек.Магазин));
		ДанныеЧека.Вставить("cash_register", Строка(ДокументЧек.КассаККМ));
		ДанныеЧека.Вставить("cashier", Строка(ДокументЧек.Продавец));
		ДанныеЧека.Вставить("total_cents", Окр(ДокументЧек.СуммаДокумента * 100, 0));
		ДанныеЧека.Вставить("stars_spent", 0);

		Если ЕстьКарта Тогда
			КодКарты = Строка(ДокументЧек.ДисконтнаяКарта.КодКарты);
			ДанныеЧека.Вставить("card_number", КодКарты);
			ДанныеЧека.Вставить("card_token", ОчиститиКодКартиStarClub(КодКарты));
		Иначе
			ДанныеЧека.Вставить("card_number", "");
			ДанныеЧека.Вставить("card_token", "");
		КонецЕсли;

		Если ЗначениеЗаполнено(КодQRЗаЗірки) Тогда
			ДанныеЧека.Вставить("reward_qr_token", СокрЛП(Строка(КодQRЗаЗірки)));
		КонецЕсли;

		ТоварыJSON = Новый Массив;
		РазрешеннаяСуммаКоп = 0;

		Для Каждого СтрокаТовара Из ДокументЧек.Товары Цикл
			ТоварJSON = Новый Структура;
			СуммаСтрокиКоп = Окр(СтрокаТовара.Сумма * 100, 0);
			ЦенаКоп = Окр(СтрокаТовара.Цена * 100, 0);

			StarClubДодатиКодиТоваруІГрупи(ТоварJSON, СтрокаТовара.Номенклатура);
			ТоварJSON.Вставить("name", Строка(СтрокаТовара.Номенклатура.Наименование));
			ТоварJSON.Вставить("qty", СтрокаТовара.Количество);
			ТоварJSON.Вставить("price_cents", ЦенаКоп);
			ТоварJSON.Вставить("line_total_cents", СуммаСтрокиКоп);

			Флаги = Новый Структура;
			Флаги.Вставить("is_alcohol", Ложь);
			Флаги.Вставить("is_tobacco", Ложь);
			Флаги.Вставить("is_min_margin", Ложь);
			Флаги.Вставить("no_star_accrual", Ложь);
			Флаги.Вставить("no_redeem", Ложь);

			Попытка
				Если СтрокаТовара.Номенклатура.ПодакцизныйТовар Тогда
					Флаги.is_alcohol = Истина;
					Флаги.no_star_accrual = Истина;
					Флаги.no_redeem = Истина;
				Иначе
					РазрешеннаяСуммаКоп = РазрешеннаяСуммаКоп + СуммаСтрокиКоп;
				КонецЕсли;
			Исключение
				РазрешеннаяСуммаКоп = РазрешеннаяСуммаКоп + СуммаСтрокиКоп;
			КонецПопытки;

			Если ЗначениеЗаполнено(КодQRЗаЗірки) Тогда
				Флаги.no_star_accrual = Истина;
				Флаги.no_redeem = Истина;
			КонецЕсли;

			ТоварJSON.Вставить("flags", Флаги);
			ТоварыJSON.Добавить(ТоварJSON);
		КонецЦикла;

		ДанныеЧека.Вставить("eligible_cents", РазрешеннаяСуммаКоп);
		ДанныеЧека.Вставить("items", ТоварыJSON);

		HTTPОтвет = StarClubPOST("/api/1c/receipts", ДанныеЧека);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Сообщить("Star Club: фіскальний чек синхронізовано.");
		Иначе
			Сообщить("Star Club: помилка API. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка відправки чека: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция StarClubЗнайтиИсходныйЧекВозврата(ДокументВозврат) Экспорт
	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.ЧекККМОснование) Тогда
			Возврат ДокументВозврат.ЧекККМОснование;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.ДокументОснование) Тогда
			Возврат ДокументВозврат.ДокументОснование;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.Основание) Тогда
			Возврат ДокументВозврат.Основание;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Процедура ОтправитьВозвратВStarClub(ДокументВозврат, ИсходныйЧек = Неопределено) Экспорт
	Попытка
		Если ИсходныйЧек = Неопределено Тогда
			ИсходныйЧек = StarClubЗнайтиИсходныйЧекВозврата(ДокументВозврат);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ИсходныйЧек) Тогда
			// Повернення без зв'язку з первинним чеком не може коректно скасувати бонуси.
			Возврат;
		КонецЕсли;

		ИсходныйОбъект = ИсходныйЧек;
		Попытка
			ИсходныйОбъект = ИсходныйЧек.ПолучитьОбъект();
		Исключение
		КонецПопытки;

		Если НЕ ЗначениеЗаполнено(ИсходныйОбъект.ДисконтнаяКарта) Тогда
			// За первинним чеком без картки зірки не нараховувались.
			Возврат;
		КонецЕсли;

		ДанныеВозврата = Новый Структура;
		ДанныеВозврата.Вставить("id", Строка(ДокументВозврат.Ссылка));
		ДанныеВозврата.Вставить("fiscal_number", Строка(ДокументВозврат.Номер));
		ДанныеВозврата.Вставить("original_receipt_id", Строка(ИсходныйОбъект.Ссылка));
		ДанныеВозврата.Вставить("returned_at", Формат(ДокументВозврат.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		ДанныеВозврата.Вставить("store_id", Строка(ДокументВозврат.Магазин));
		ДанныеВозврата.Вставить("cash_register", Строка(ДокументВозврат.КассаККМ));
		ДанныеВозврата.Вставить("cashier", Строка(ДокументВозврат.Продавец));
		ДанныеВозврата.Вставить("total_cents", Окр(ДокументВозврат.СуммаДокумента * 100, 0));
		ДанныеВозврата.Вставить("card_number", Строка(ИсходныйОбъект.ДисконтнаяКарта.КодКарты));

		ТоварыJSON = Новый Массив;
		РазрешеннаяСуммаКоп = 0;
		Для Каждого СтрокаТовара Из ДокументВозврат.Товары Цикл
			ТоварJSON = Новый Структура;
			СуммаСтрокиКоп = Окр(Абс(СтрокаТовара.Сумма) * 100, 0);
			ЦенаКоп = Окр(Абс(СтрокаТовара.Цена) * 100, 0);
			StarClubДодатиКодиТоваруІГрупи(ТоварJSON, СтрокаТовара.Номенклатура);
			ТоварJSON.Вставить("name", Строка(СтрокаТовара.Номенклатура.Наименование));
			ТоварJSON.Вставить("qty", Абс(СтрокаТовара.Количество));
			ТоварJSON.Вставить("price_cents", ЦенаКоп);
			ТоварJSON.Вставить("line_total_cents", СуммаСтрокиКоп);
			ТоварыJSON.Добавить(ТоварJSON);
			РазрешеннаяСуммаКоп = РазрешеннаяСуммаКоп + СуммаСтрокиКоп;
		КонецЦикла;

		ДанныеВозврата.Вставить("eligible_cents", РазрешеннаяСуммаКоп);
		ДанныеВозврата.Вставить("items", ТоварыJSON);
		ДанныеВозврата.Вставить("full_return", ТоварыJSON.Количество() = 0);

		HTTPОтвет = StarClubPOST("/api/1c/returns", ДанныеВозврата);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Сообщить("Star Club: повернення синхронізовано, нараховані зірки скориговано.");
		Иначе
			Сообщить("Star Club: помилка повернення. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка синхронізації повернення: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ОбробитиПробитийЧекStarClub(ДокументЧек) Экспорт
	// Викликати ТІЛЬКИ після успішного фіскального пробиття у РМК.
	Попытка
		ЭтоВозврат = Ложь;
		Попытка
			ЭтоВозврат = ДокументЧек.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат;
		Исключение
			ЭтоВозврат = СтрНайти(НРег(Строка(ДокументЧек.ВидОперации)), "возврат") > 0;
		КонецПопытки;

		Если ЭтоВозврат Тогда
			ОтправитьВозвратВStarClub(ДокументЧек);
		Иначе
			ОтправитьЧекВStarClub(ДокументЧек);
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка обробки пробитого чека: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры


