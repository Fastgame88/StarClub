КонецФункции

Функция ЗапитатиТаПідтвердитиКодТовараЗаЗірки(НомерЧека = "") Экспорт
	КодQR = "";
	Если НЕ ВвестиСтроку(КодQR, "Введіть код товару Star Club для списання", 100) Тогда
		Возврат "";
	КонецЕсли;
	Если СокрЛП(Строка(НомерЧека)) = "" Тогда
		НомерЧека = "MANUAL-" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
