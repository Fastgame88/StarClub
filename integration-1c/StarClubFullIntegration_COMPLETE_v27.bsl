КонецФункции

Функция StarClubПідготуватиПоповнення(КодКарты, СуммаГрн, ВидОплаты, Магазин, Касса, Кассир) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("card_number", СокрЛП(Строка(КодКарты)));
    Данные.Вставить("amount_cents", Окр(Число(СуммаГрн) * 100, 0));
    Данные.Вставить("payment_method", СокрЛП(Строка(ВидОплаты)));
    Данные.Вставить("operation_type", "topup");
    StarClubДодатиМагазинВДані(Данные, Магазин);
    Данные.Вставить("cash_register", Строка(Касса));
    Данные.Вставить("cashier", Строка(Кассир));
    Ответ = StarClubPOST("/api/1c/change-accrual/prepare", Данные);
    Возврат StarClubПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция StarClubПідготуватиЗРешти(КодКарты, СуммаГрн, Магазин, Касса, Кассир) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("card_number", СокрЛП(Строка(КодКарты)));
    Данные.Вставить("amount_cents", Окр(Число(СуммаГрн) * 100, 0));
    Данные.Вставить("payment_method", "cash_change");
    Данные.Вставить("operation_type", "change");
    StarClubДодатиМагазинВДані(Данные, Магазин);
    Данные.Вставить("cash_register", Строка(Касса));
    Данные.Вставить("cashier", Строка(Кассир));
    Ответ = StarClubPOST("/api/1c/change-accrual/prepare", Данные);
    Возврат StarClubПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция StarClubЗавершитиПоповнення(ИдентификаторОперации, НомерЧека, ФискальныйНомер, Магазин, Касса, Кассир) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("operation_id", Строка(ИдентификаторОперации));
    Данные.Вставить("receipt_id", Строка(НомерЧека));
    Данные.Вставить("receipt_number", Строка(НомерЧека));
    Данные.Вставить("fiscal_receipt_number", Строка(ФискальныйНомер));
    StarClubДодатиМагазинВДані(Данные, Магазин);
    Данные.Вставить("cash_register", Строка(Касса));
    Данные.Вставить("cashier", Строка(Кассир));
    Ответ = StarClubPOST("/api/1c/change-accrual/complete", Данные);
    Возврат StarClubПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция StarClubСкасуватиПоповнення(ИдентификаторОперации, Причина = "Операцію скасовано касиром") Экспорт
    Данные = Новый Структура;
    Данные.Вставить("operation_id", Строка(ИдентификаторОперации));
    Данные.Вставить("reason", Строка(Причина));
    Ответ = StarClubPOST("/api/1c/change-accrual/cancel", Данные);
    Возврат StarClubПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Процедура StarClubЗаблокуватиКредитНаФормі(Форма, Заблокувати = Истина) Экспорт
    Для Каждого ИмяКнопки Из Новый Массив("Кредит", "КнопкаКредит", "ОплатаКредит", "КредитнаяОплата") Цикл
        Попытка Форма.ЭлементыФормы[ИмяКнопки].Доступность = НЕ Заблокувати; Исключение КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Процедура StarClubЗаписатиСумиУФормуРозрахунку(ФормаРозрахунку, СуммаStarClub, СуммаЧека) Экспорт
    StarClubБезопасноУстановить(ФормаРозрахунку, "СуммаStarClub", СуммаStarClub);
    StarClubБезопасноУстановить(ФормаРозрахунку, "СумаStarClub", СуммаStarClub);
    StarClubБезопасноУстановить(ФормаРозрахунку, "СуммаКОплате", Число(СуммаЧека) + Число(СуммаStarClub));
    StarClubБезопасноУстановить(ФормаРозрахунку, "Сумма", Число(СуммаЧека) + Число(СуммаStarClub));
КонецПроцедуры
