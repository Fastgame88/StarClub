// ---------- КНОПКА: РОЗРАХУВАТИ STAR CLUB ----------
Процедура КнопкаРозрахуватиStarClubНажатие(Элемент)

	// ЗАМІНІТЬ ТекущийЧек на реальний об'єкт поточного чека у вашій формі РМК.
	Если НЕ ЗначениеЗаполнено(ТекущийЧек.ДисконтнаяКарта) Тогда
		Сообщить("Star Club: картка не вибрана. Чек можна провести як звичайний без бонусів.");
		Возврат;
	КонецЕсли;

	Ответ = StarClubИнтеграция.ЗастосуватиКлубніУмовиStarClub(
		ТекущийЧек.Товары,
		ТекущийЧек.ДисконтнаяКарта,
		ТекущийЧек.Магазин,
		ТекущийЧек.Дата
	);

	Если Ответ <> Неопределено Тогда
		// Оновіть суму/форму штатною процедурою вашого РМК.
		// Наприклад: ПересчитатьИтоги(); ОбновитьФормуЧека();
	КонецЕсли;

КонецПроцедуры

