# Server
PORT=3000
APP_URL=https://your-domain.up.railway.app
WEBAPP_URL=https://your-domain.up.railway.app
NODE_ENV=production

# SQLite. Railway Volume mount: /app/data
DATABASE_FILE=./data/star-club.sqlite

# Telegram
BOT_TOKEN=123456:telegram_bot_token_from_botfather
RUN_BOT=true
ALLOW_DEV_LOGIN=true
ENABLE_DEMO_ACCOUNT=false

# API tokens
ADMIN_API_KEY=change-this-admin-key
ONE_C_API_TOKEN=change-this-1c-token

# Telegram IDs that automatically receive Owner access in /admin
# Multiple IDs separated by commas
OWNER_TELEGRAM_IDS=111111111

# Admin users and their section permissions are created by Owner inside /admin.
# Do not add Admin Telegram IDs to ENV.
# Technical fiscal price for a reward item (kopecks). 10 = 0.10 UAH.
REWARD_TECHNICAL_PRICE_CENTS=10
